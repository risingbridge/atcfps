{
  "name": "ATC Strip Board",
  "short_name": "Strips",
  "description": "Flight progress strip board — local-only, no sync.",
  "start_url": "/atcfps/",
  "scope": "/atcfps/",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#1B1F24",
  "theme_color": "#1B1F24",
  "icons": [
    { "src": "/atcfps/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/atcfps/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/atcfps/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
